<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.feevale.view.TelaAtendimentosController">

    <top>
        <Label text="Atendimentos"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 15;" />
    </top>

    <center>
        <ListView fx:id="listaAtendimentos"
                  prefHeight="300"
                  prefWidth="400" />
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15;">
            <Button text="Novo Atendimento" 
                    fx:id="btnNovo"
                    onAction="#novoAtendimento"
                    prefWidth="160"/>

            <Button text="Alterar Status"
                    fx:id="btnAlterar"
                    onAction="#abrirTelaStatus"
                    prefWidth="160"/>
        </HBox>
    </bottom>

</BorderPane>
