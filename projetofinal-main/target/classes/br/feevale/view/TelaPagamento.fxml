<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.feevale.view.TelaPagamentoController">

    <Label layoutX="150" layoutY="20" text="Pagamento"/>

    <Label layoutX="50" layoutY="80" text="Total:"/>
    <Label layoutX="150" layoutY="80" fx:id="lblTotal" text="0.00"/>

    <Label layoutX="50" layoutY="130" text="Forma de Pagamento"/>
    <TextField layoutX="50" layoutY="160" fx:id="txtFormaPagamento" prefWidth="300"/>

    <Button layoutX="50" layoutY="220" text="Confirmar" fx:id="btnConfirmar"/>
    <Button layoutX="270" layoutY="220" text="Cancelar" fx:id="btnCancelar"/>

</AnchorPane>
