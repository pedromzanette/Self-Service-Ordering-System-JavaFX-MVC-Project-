<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800" prefWidth="430" style="-fx-background-color: #F7F3E9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.feevale.view.TelaInicialController">

    <!-- FUNDO -->
    <ImageView fitHeight="800" fitWidth="430">
        <image>
            <Image url="@images/fundo.png" />
        </image>
    </ImageView>

    <!-- LOGO (descida 20px para melhor equilíbrio) -->
    <ImageView fitWidth="180" layoutX="125" layoutY="90" preserveRatio="true">
        <image>
            <Image url="@images/logo.png" />
        </image>
    </ImageView>

    <!-- TÍTULO (ajustado para alinhamento perfeito) -->
    <Label layoutX="100.0" layoutY="347.0" style="-fx-font-size: 36px; -fx-font-family: 'Montserrat'; -fx-font-weight: bold; -fx-text-fill: #1B4332;" text="Campus Brew" />

    <Label layoutX="179.0" layoutY="390.0" style="-fx-font-size: 36px; -fx-font-family: 'Montserrat'; -fx-font-weight: bold; -fx-text-fill: #1B4332;" text="Café" />

    <!-- BOTÃO NOVO PEDIDO (com sombra premium) -->
    <Button fx:id="btnPedido" layoutX="58" layoutY="570" prefHeight="60" prefWidth="318" style="-fx-background-color: #1B4332;                    -fx-background-radius: 18;                    -fx-font-family: 'Montserrat';                    -fx-text-fill: white;                    -fx-font-weight: bold;                    -fx-font-size: 20px;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.2, 0, 3);" text="Novo Pedido">
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </Button>

</AnchorPane>
