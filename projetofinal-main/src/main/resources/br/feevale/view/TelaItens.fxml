<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.feevale.view.TelaItensController">

    <Label layoutX="150" layoutY="20" text="Itens Disponíveis" />

    <ListView fx:id="listaItens" layoutX="50" layoutY="60" prefWidth="300" prefHeight="180"/>

    <Button layoutX="50" layoutY="250" text="Adicionar" fx:id="btnAdicionar"/>
    <Button layoutX="160" layoutY="250" text="Remover" fx:id="btnRemover"/>
    <Button layoutX="270" layoutY="250" text="Carrinho" fx:id="btnCarrinho"/>

</AnchorPane>
