<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.feevale.view.TelaAlterarStatusController">

    <Label layoutX="130" layoutY="20" text="Atualizar Status dos Pedidos"/>

    <ListView fx:id="listaAtendimentos" layoutX="50" layoutY="60" prefWidth="300" prefHeight="180"/>

    <Button layoutX="50" layoutY="250" text="Atualizar Status" fx:id="btnAtualizar"/>
    <Button layoutX="270" layoutY="250" text="Voltar" fx:id="btnVoltar"/>

</AnchorPane>