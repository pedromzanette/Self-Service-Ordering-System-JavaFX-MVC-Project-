<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.feevale.view.TelaCarrinhoController">

    <Label layoutX="160" layoutY="20" text="Carrinho"/>

    <ListView fx:id="listaCarrinho" layoutX="50" layoutY="60" prefWidth="300" prefHeight="180"/>

    <Button layoutX="50" layoutY="250" text="Voltar" fx:id="btnVoltar"/>
    <Button layoutX="270" layoutY="250" text="Finalizar" fx:id="btnFinalizar"/>

</AnchorPane>
